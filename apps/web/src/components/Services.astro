---
import Van from "./art/Van.astro";
import Tutor from "./art/Tutor.astro";
import X1 from "./art/X1.astro";
import Sticker from "./art/Sticker.astro";
import Pin from "./art/Pin.astro";
import Doodle from "./art/Doodle.astro";

// A. The promise in three beats
const promise = [
  { n: "01", title: "We come to you", body: "A StemGrid tutor visits your school every week with the whole lab in tow." },
  { n: "02", title: "We teach it all", body: "A grade-wise program for Grades 4 to 12, planned, taught and tracked by us." },
  { n: "03", title: "They build robots", body: "Students go from a blinking LED to robots they wire and code themselves." },
];

// B. What rolls out of the van
const cargo = [
  { id: "tutor", label: "A trained tutor", sub: "Same tutor, every week" },
  { id: "kits", label: "Quark Kits", sub: "A full class set, charged" },
  { id: "x1", label: "X1 consoles", sub: "For the youngest builders" },
  { id: "parts", label: "Sensors & motors", sub: "Boards, servos, cables" },
  { id: "book", label: "The curriculum", sub: "Grade-wise, NEP 2020" },
  { id: "report", label: "Reports", sub: "Progress + certificates" },
];

// C. Grade pathway
const grades = [4, 5, 6, 7, 8, 9, 10, 11, 12];
const levels = [
  {
    id: "explorers", name: "Explorers", grades: "Grades 4–5", title: "First circuits",
    body: "They make things light up, beep and blink, and finally see why a circuit works.",
    ticks: [4, 5], builds: ["Night lamp", "Traffic light", "Reaction buzzer"], tools: "X1 · Block coding", level: 1,
  },
  {
    id: "builders", name: "Builders", grades: "Grades 6–8", title: "Sensors & first robots",
    body: "Their builds start sensing the world, and then moving through it.",
    ticks: [6, 7, 8], builds: ["Parking sensor", "Plant monitor", "Obstacle-dodging car"], tools: "Quark Kit · Block coding", level: 2,
  },
  {
    id: "innovators", name: "Innovators", grades: "Grades 9–12", title: "Code, IoT & real robots",
    body: "Real MicroPython, connected systems and robots built to compete.",
    ticks: [9, 10, 11, 12], builds: ["Wi-Fi weather station", "RFID attendance", "Robotic arm", "Competition bot"], tools: "Quark Kit · MicroPython", level: 3,
  },
];

// D. Ways to work with us
const ways = [
  {
    id: "partner", tag: "We run it all", title: "Full STEM partner",
    body: "Hand us your STEM program. We plan it, staff it, equip it and report on it, all year long.",
    items: ["Weekly tutor-led classes", "Lab on Wheels, or a lab we set up for you", "Grade-wise curriculum & assessments", "Competitions, expos & certificates", "Reports for parents & principals"],
    best: "Schools that want STEM done properly, without hiring or buying.",
    img: "/img/stock/class-showcase.jpg", alt: "A tutor and students talking over the robots they built", dark: true,
  },
  {
    id: "cohorts", tag: "Focused programs", title: "Electronics & robotics cohorts",
    body: "Focused batches where students go from their first circuit to a finished, working robot.",
    items: ["Clubs after school or in your timetable", "Summer & winter camps", "Grade-matched batches", "Ends in a live build showcase"],
    best: "Starting out, or adding a robotics club to what you already run.",
    img: "/img/stock/students-building.jpg", alt: "Three students wiring up their robot builds at a lab table",
  },
  {
    id: "kits", tag: "Own the hardware", title: "Kits for your own lab",
    body: "Buy Quark Kits and X1 consoles outright, with the software and training to use them well.",
    items: ["Quark Kit · 13 plug-and-play modules", "Qbitio X1 learning consoles", "NerdEditor coding software", "Teacher training", "Maintenance plans & spares"],
    best: "Schools building a permanent STEM or ATL lab.",
    img: "/img/stock/hands-on-kit.jpg", alt: "Students sorting kit parts during a hands-on lesson",
  },
];
---
<section id="services" class="svc" aria-labelledby="svc-title">
  <!-- A. Intro + promise -->
  <div class="svc-intro wrap">
    <div class="svc-grid-bg" aria-hidden="true"></div>
    <p class="kicker"><span>03 · What we do</span></p>
    <h2 id="svc-title" class="svc-h" aria-label="We run STEM. Start to finish.">
      <span class="svc-h-1" aria-hidden="true">{"We run STEM.".split(" ").map((w) => <span class="svc-hw">{w}</span>)}</span>
      <span class="svc-h-2" aria-hidden="true">Start to finish.</span>
    </h2>
    <p class="svc-lead">
      You don't need a lab, a robotics teacher or a single kit. We bring all of it to your school and leave behind students who can build.
    </p>

    <ol class="promise">
      <svg class="promise-cable" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <path class="pc-draw" pathLength="1" d="M60 20 C 220 -10, 330 50, 500 20 S 800 -10, 940 20" stroke="#111" stroke-width="10" fill="none" stroke-linecap="round" />
        <path class="pc-draw" pathLength="1" d="M60 20 C 220 -10, 330 50, 500 20 S 800 -10, 940 20" stroke="#E3121B" stroke-width="5" fill="none" stroke-linecap="round" />
      </svg>
      {promise.map((p, i) => (
        <li class="pr">
          <span class="pr-icon" aria-hidden="true">
            {i === 0 && <Pin class="pr-svg pr-pin" />}
            {i === 1 && <Doodle name="chip" class="pr-svg" />}
            {i === 2 && <Doodle name="robot" class="pr-svg" />}
          </span>
          <span class="pr-n">{p.n}</span>
          <h3 class="pr-title">{p.title}</h3>
          <p class="pr-body">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>

  <!-- B. Haul: a full-screen classroom. The van rolls in, the whole lab rolls out (pinned, scrubbed) -->
  <div class="haul">
    <div class="haul-pin room">
      <div class="room-dots" aria-hidden="true"></div>

      <div class="board">
        <p class="haul-kicker">Every week, at your school</p>
        <h3 class="haul-title">You give us a classroom. <em>We bring the rest.</em></h3>
        <div class="board-row" aria-hidden="true">
          <span class="rb-week">Week 07</span>
          <span class="rb-task">Today: build a smart night lamp</span>
          <span class="rb-dot"></span>
        </div>
      </div>

      <ul class="sr-only">
        {cargo.map((c) => <li>{c.label}: {c.sub}</li>)}
      </ul>

      <div class="cargo-grid" aria-hidden="true">
        {cargo.map((c) => (
          <div class:list={["cargo", `cargo-${c.id}`]}>
            <div class="cargo-art">
              {c.id === "tutor" && <Tutor class="ca-svg ca-tutor" />}
              {c.id === "kits" && <Sticker kind="c3" class="ca-svg" />}
              {c.id === "x1" && <X1 class="ca-svg ca-x1" />}
              {c.id === "parts" && <Sticker kind="servo" class="ca-svg" />}
              {c.id === "book" && (
                <svg viewBox="0 0 120 110" class="ca-svg">
                  <rect x="22" y="14" width="80" height="88" rx="8" fill="#111" transform="translate(5 6)" />
                  <rect x="22" y="14" width="80" height="88" rx="8" fill="#E3121B" stroke="#111" stroke-width="4" />
                  <rect x="22" y="14" width="14" height="88" rx="4" fill="#B20912" stroke="#111" stroke-width="4" />
                  <rect x="44" y="30" width="48" height="30" rx="5" fill="#FFF3E0" stroke="#111" stroke-width="3" />
                  <text x="68" y="51" text-anchor="middle" font-family="Bagel Fat One, sans-serif" font-size="17" fill="#E3121B">4–12</text>
                  <rect x="46" y="70" width="44" height="5" rx="2.5" fill="#FFF3E0" opacity=".8" />
                  <rect x="46" y="81" width="30" height="5" rx="2.5" fill="#FFF3E0" opacity=".8" />
                  <path d="M84 10 V34 L90 28 L96 34 V10 Z" fill="#FFB21A" stroke="#111" stroke-width="3" stroke-linejoin="round" />
                </svg>
              )}
              {c.id === "report" && (
                <svg viewBox="0 0 120 110" class="ca-svg">
                  <rect x="20" y="10" width="80" height="94" rx="8" fill="#111" transform="translate(5 6)" />
                  <rect x="20" y="10" width="80" height="94" rx="8" fill="#FFFDF7" stroke="#111" stroke-width="4" />
                  <rect x="32" y="22" width="40" height="6" rx="3" fill="#111" />
                  <g class="rep-bars">
                    <rect x="34" y="66" width="10" height="20" rx="2" fill="#F0574D" stroke="#111" stroke-width="2.5" />
                    <rect x="50" y="56" width="10" height="30" rx="2" fill="#F0574D" stroke="#111" stroke-width="2.5" />
                    <rect x="66" y="44" width="10" height="42" rx="2" fill="#E3121B" stroke="#111" stroke-width="2.5" />
                  </g>
                  <path d="M30 88 H90" stroke="#111" stroke-width="3" stroke-linecap="round" />
                  <circle cx="88" cy="26" r="16" fill="#E3121B" stroke="#111" stroke-width="3.5" />
                  <text x="88" y="32" text-anchor="middle" font-family="Bagel Fat One, sans-serif" font-size="15" fill="#FFF3E0">A+</text>
                </svg>
              )}
            </div>
            <span class="cargo-label">{c.label}</span>
            <span class="cargo-sub">{c.sub}</span>
          </div>
        ))}
      </div>

      <div class="room-floor" aria-hidden="true">
        <div class="haul-road"><div class="haul-dash"></div></div>
        <div class="haul-van"><div class="haul-van-in"><Van class="haul-van-svg" /></div></div>
        <div class="puff"><span></span><span></span><span></span></div>
      </div>

      <p class="haul-foot"><span>You buy <b>nothing</b>.</span> <span>You store <b>nothing</b>.</span> <span>You maintain <b>nothing</b>.</span></p>
    </div>
  </div>

  <!-- C. Programs: one staircase from Grade 4 to 12 -->
  <div id="programs" class="prog" aria-labelledby="prog-title">
    <div class="prog-bg" aria-hidden="true">
      <div class="prog-sun"><div class="prog-rays"></div><div class="prog-glow"></div><div class="prog-shade"></div></div>
    </div>
    <div class="prog-in wrap">
      <div class="prog-head">
        <div>
          <p class="prog-kicker">Programs · Grade 4 to 12</p>
          <h3 id="prog-title" class="prog-title">Every year, <em>a step up.</em></h3>
        </div>
        <p class="prog-intro">One pathway from a student's first circuit to a robot they code themselves. Each level builds on the last, and every term ends with something that works.</p>
      </div>

      <div class="stairs">
        {levels.map((l, i) => (
          <article class:list={["stp", `stp-${i + 1}`, `lvl-${l.id}`]}>
            <div class="stp-top" aria-hidden="true">
              <span class="stp-no">{`0${i + 1}`}</span>
              {i === 2 && (
                <span class="summit"><span class="summit-pole"></span><span class="summit-flag">Robots!</span></span>
              )}
            </div>
            <div class="stp-card">
              <div class="stp-art" aria-hidden="true">
              {l.id === "explorers" && (
                <svg viewBox="0 0 320 240" class="lvl-svg" overflow="visible">
                  <rect x="12" y="14" width="300" height="214" rx="26" fill="#111" />
                  <rect x="4" y="6" width="300" height="214" rx="26" fill="#FBF7EF" stroke="#111" stroke-width="4" />
                  <g fill="#E2D6C3">{Array.from({ length: 6 }, (_, r) => Array.from({ length: 9 }, (_, c) => <circle cx={30 + c * 31} cy={30 + r * 33} r="6" />))}</g>
                  <g fill="none" stroke-linecap="round">
                    <path d="M70 150 C70 70 120 60 150 70" stroke="#111" stroke-width="11" />
                    <path d="M70 150 C70 70 120 60 150 70" stroke="#E3121B" stroke-width="5" />
                    <path d="M214 70 C260 70 250 110 250 120" stroke="#111" stroke-width="11" />
                    <path d="M214 70 C260 70 250 110 250 120" stroke="#FFB21A" stroke-width="5" />
                    <path d="M250 196 C250 214 90 214 90 196" stroke="#111" stroke-width="11" />
                    <path d="M250 196 C250 214 90 214 90 196" stroke="#FF7A1A" stroke-width="5" />
                  </g>
                  <g>
                    <rect x="38" y="140" width="84" height="62" rx="12" fill="#111" transform="translate(5 6)" />
                    <rect x="38" y="140" width="84" height="62" rx="12" fill="#FF6B1A" stroke="#111" stroke-width="3.5" />
                    <rect x="50" y="152" width="44" height="38" rx="6" fill="#2A2A2A" stroke="#111" stroke-width="3" />
                    <rect x="94" y="164" width="8" height="14" rx="2" fill="#2A2A2A" />
                    <text x="72" y="177" text-anchor="middle" font-family="Archivo Variable, sans-serif" font-weight="900" font-size="12" fill="#FFF3E0" style="font-stretch:125%">3V</text>
                  </g>
                  <g>
                    <rect x="146" y="46" width="72" height="52" rx="12" fill="#111" transform="translate(5 6)" />
                    <rect x="146" y="46" width="72" height="52" rx="12" fill="#FF6B1A" stroke="#111" stroke-width="3.5" />
                    <circle class="lv-btn" cx="182" cy="72" r="15" fill="#E3121B" stroke="#111" stroke-width="3.5" />
                  </g>
                  <circle class="lv-glow" cx="250" cy="158" r="54" fill="#FF3B30" />
                  <g>
                    <rect x="216" y="118" width="68" height="78" rx="12" fill="#111" transform="translate(5 6)" />
                    <rect x="216" y="118" width="68" height="78" rx="12" fill="#FF6B1A" stroke="#111" stroke-width="3.5" />
                    <circle class="lv-dome" cx="250" cy="154" r="18" fill="#FF2A2A" stroke="#111" stroke-width="3.5" />
                    <ellipse cx="244" cy="147" rx="5" ry="3.5" fill="#fff" opacity=".5" />
                    <text x="250" y="188" text-anchor="middle" font-family="Archivo Variable, sans-serif" font-weight="900" font-size="9" letter-spacing="1.5" fill="#111" style="font-stretch:125%">LED</text>
                  </g>
                </svg>
              )}
              {l.id === "builders" && (
                <svg viewBox="0 0 320 240" class="lvl-svg" overflow="visible">
                  <path d="M0 222 H320" stroke="#111" stroke-width="5" stroke-linecap="round" />
                  <g class="lv-floor" stroke="#111" stroke-width="4" stroke-linecap="round" opacity=".35">
                    <path d="M20 234 h24" /><path d="M90 234 h24" /><path d="M160 234 h24" /><path d="M230 234 h24" />
                  </g>
                  <rect x="300" y="110" width="20" height="112" rx="5" fill="#E2D6C3" stroke="#111" stroke-width="4" />
                  <g class="lv-waves" fill="none" stroke="#E3121B" stroke-width="5" stroke-linecap="round">
                    <path class="lv-wave" d="M250 118 a26 26 0 0 1 0 40" />
                    <path class="lv-wave" d="M262 106 a42 42 0 0 1 0 64" />
                    <path class="lv-wave" d="M274 94 a58 58 0 0 1 0 88" />
                  </g>
                  <g class="lv-car">
                    <rect x="38" y="112" width="196" height="76" rx="20" fill="#111" transform="translate(6 7)" />
                    <rect x="38" y="112" width="196" height="76" rx="20" fill="#FF6B1A" stroke="#111" stroke-width="4" />
                    <rect x="66" y="84" width="104" height="34" rx="8" fill="#F4F1EA" stroke="#111" stroke-width="3.5" />
                    <rect x="78" y="92" width="34" height="18" rx="3" fill="#2A2A2A" />
                    <circle class="lv-blink" cx="150" cy="101" r="6" fill="#E3121B" stroke="#111" stroke-width="2.5" />
                    <path d="M100 84 V60" stroke="#111" stroke-width="4" stroke-linecap="round" />
                    <circle cx="100" cy="56" r="7" fill="#E3121B" stroke="#111" stroke-width="3" />
                    <rect x="208" y="118" width="40" height="44" rx="8" fill="#2F6FD6" stroke="#111" stroke-width="3.5" />
                    <circle cx="228" cy="130" r="9" fill="#D5DAE1" stroke="#111" stroke-width="2.5" />
                    <circle cx="228" cy="151" r="9" fill="#D5DAE1" stroke="#111" stroke-width="2.5" />
                    <rect x="54" y="132" width="80" height="10" rx="5" fill="#111" opacity=".8" />
                    <rect x="54" y="150" width="56" height="10" rx="5" fill="#111" opacity=".8" />
                    <g class="lv-wheel">
                      <circle cx="84" cy="192" r="28" fill="#111" />
                      <circle cx="84" cy="192" r="12" fill="#FFB21A" />
                      <path d="M84 176 V208 M68 192 H100" stroke="#111" stroke-width="4" />
                    </g>
                    <g class="lv-wheel">
                      <circle cx="194" cy="192" r="28" fill="#111" />
                      <circle cx="194" cy="192" r="12" fill="#FFB21A" />
                      <path d="M194 176 V208 M178 192 H210" stroke="#111" stroke-width="4" />
                    </g>
                  </g>
                </svg>
              )}
              {l.id === "innovators" && (
                <svg viewBox="0 0 320 240" class="lvl-svg" overflow="visible">
                  <g>
                    <rect x="170" y="10" width="146" height="96" rx="14" fill="#E3121B" transform="translate(6 7)" />
                    <rect x="170" y="10" width="146" height="96" rx="14" fill="#111" stroke="#111" stroke-width="3" />
                    <circle cx="186" cy="24" r="4" fill="#F0574D" /><circle cx="198" cy="24" r="4" fill="#FFB21A" /><circle cx="210" cy="24" r="4" fill="#5FD38D" />
                    <g font-family="ui-monospace, Consolas, monospace" font-size="11" font-weight="700">
                      <text x="184" y="50" fill="#F0574D">while</text><text x="222" y="50" fill="#FFF3E0">True:</text>
                      <text x="196" y="68" fill="#FFF3E0">arm.grab()</text>
                      <text x="196" y="86" fill="#FFB21A">wifi.send(t)</text>
                    </g>
                    <rect class="lv-caret" x="270" y="77" width="7" height="12" fill="#FFF3E0" />
                  </g>
                  <g class="lv-wifi" fill="none" stroke="#111" stroke-width="5" stroke-linecap="round">
                    <path d="M126 40 a26 26 0 0 1 36 0" /><path d="M116 28 a42 42 0 0 1 56 0" />
                    <circle cx="144" cy="54" r="5" fill="#111" stroke="none" />
                  </g>
                  <path d="M10 226 H310" stroke="#111" stroke-width="5" stroke-linecap="round" />
                  <rect x="28" y="196" width="124" height="30" rx="10" fill="#111" />
                  <rect x="214" y="196" width="40" height="30" rx="5" fill="#FFB21A" stroke="#111" stroke-width="3.5" />
                  <g class="lv-arm1">
                    <rect x="76" y="96" width="28" height="104" rx="14" fill="#111" transform="translate(5 5)" />
                    <rect x="76" y="96" width="28" height="104" rx="14" fill="#FF6B1A" stroke="#111" stroke-width="3.5" />
                    <g class="lv-arm2">
                      <rect x="86" y="92" width="104" height="26" rx="13" fill="#111" transform="translate(5 5)" />
                      <rect x="86" y="92" width="104" height="26" rx="13" fill="#FF6B1A" stroke="#111" stroke-width="3.5" />
                      <g class="lv-claw" stroke="#111" stroke-width="5" stroke-linecap="round" fill="none">
                        <path d="M184 104 l18 -14 l12 10" /><path d="M184 106 l18 14 l12 -10" />
                      </g>
                      <circle cx="180" cy="105" r="9" fill="#F4F1EA" stroke="#111" stroke-width="3" />
                    </g>
                    <circle cx="90" cy="104" r="13" fill="#F4F1EA" stroke="#111" stroke-width="3.5" />
                  </g>
                  <circle cx="90" cy="196" r="14" fill="#F4F1EA" stroke="#111" stroke-width="3.5" />
                </svg>
              )}
              </div>
              <div class="stp-copy">
                <div class="lvl-tags">
                  <span class="lvl-name">{l.name}</span>
                  <span class="lvl-grades">{l.grades}</span>
                </div>
                <h4 class="lvl-title">{l.title}</h4>
                <p class="lvl-body">{l.body}</p>
                <p class="lvl-sub">What they build</p>
                <ul class="lvl-builds">{l.builds.map((b) => <li>{b}</li>)}</ul>
                <div class="lvl-foot">
                  <span class="lvl-tools">{l.tools}</span>
                  <span class="lvl-meter" aria-label={`Difficulty ${l.level} of 3`}>
                    {[1, 2, 3].map((k) => <i class:list={{ on: k <= l.level }}></i>)}
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="axis" aria-hidden="true">
        <div class="axis-bar">
          <span class="axis-fill"></span>
          {levels.map((l) => (
            <div class="axis-seg">{l.ticks.map((g) => <span class="ax-g">{g}</span>)}</div>
          ))}
        </div>
        <span class="axis-label">Grade</span>
      </div>

      <div class="prog-out">
        <div class="out-photos">
          <figure class="out-ph out-ph-1"><img src="/img/stock/robot-car-build.jpg" alt="Three students testing the robot car they built" width="1100" height="733" loading="lazy" decoding="async" /></figure>
          <figure class="out-ph out-ph-2"><img src="/img/stock/tutor-guiding.jpg" alt="A tutor guiding a student through a robotics build" width="1100" height="733" loading="lazy" decoding="async" /></figure>
          <span class="out-stamp" aria-hidden="true">we<br />promise</span>
        </div>
        <div class="out-copy">
          <p class="lvl-sub">The outcome</p>
          <h4 class="out-title">Every student leaves with something they built.</h4>
          <ul class="out-list">
            <li><b>Working projects</b> they demo in class, from circuits to robots</li>
            <li><b>Certificates</b> for every student who completes a level</li>
            <li><b>Progress reports</b> for parents and principals</li>
            <li><b>Competition-ready teams</b> for expos and hackathons</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- D. Ways to work with us -->
  <div class="ways">
    <div class="ways-in wrap">
      <div class="ways-head">
        <p class="kicker"><span>Ways to work with us</span></p>
        <h3 class="ways-title">Pick how much you want <em>us to handle.</em></h3>
      </div>
      <div class="ways-grid">
        {ways.map((w) => (
          <article class:list={["way", `way-${w.id}`, { "way-dark": w.dark }]}>
            <div class="way-tilt">
              <figure class="way-ph">
                <img src={w.img} alt={w.alt} width="1100" height="733" loading="lazy" decoding="async" />
                <span class="way-tag">{w.tag}</span>
              </figure>
              <div class="way-body">
                <h4 class="way-title">{w.title}</h4>
                <p class="way-text">{w.body}</p>
                <ul class="way-items">
                  {w.items.map((it) => (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      {it}
                    </li>
                  ))}
                </ul>
                <p class="way-best"><span>Best for</span>{w.best}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="ways-cta">
        <p>Not sure which fits your school? We'll help you choose.</p>
        <a class="ways-btn" href="#contact">Book a free demo</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .svc {
    position: relative; z-index: 6; margin-top: -52px; background: var(--color-ink); color: var(--color-cream); overflow-x: clip;
    border-radius: 44px 44px 0 0; box-shadow: 0 -10px 0 0 var(--color-red);
  }
  .svc::before { content: ""; position: absolute; left: 50%; top: 14px; width: 64px; height: 6px; border-radius: 6px; translate: -50% 0; background: rgba(255,243,224,.22); }
  @media (max-width: 640px) { .svc { border-radius: 28px 28px 0 0; margin-top: -40px; } }

  /* ── A. Intro ── */
  .svc-intro { position: relative; padding-top: clamp(100px, 15vh, 170px); padding-bottom: clamp(70px, 12vh, 130px); }
  .svc-grid-bg {
    position: absolute; inset: 0 -20%; pointer-events: none;
    background-image: linear-gradient(rgba(255,243,224,.06) 2px, transparent 2px), linear-gradient(90deg, rgba(255,243,224,.06) 2px, transparent 2px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse at 70% 30%, #000 10%, transparent 65%); mask-image: radial-gradient(ellipse at 70% 30%, #000 10%, transparent 65%);
  }
  .svc-h { position: relative; margin: clamp(20px, 3vh, 34px) 0 0; font-size: clamp(2.6rem, 7.4vw, 6.4rem); line-height: 1; }
  .svc-h-1 { display: flex; flex-wrap: wrap; gap: 0 .22em; }
  .svc-hw { display: inline-block; }
  .svc-hw:last-child { color: var(--color-red); text-shadow: 0 .05em 0 var(--color-red-dark); }
  .svc-h-2 {
    display: inline-block; margin-top: .14em; font-size: .46em; padding: .14em .4em .24em; border-radius: .26em;
    background: var(--color-cream); color: var(--color-ink); box-shadow: 0 .1em 0 var(--color-red); rotate: -3deg;
  }
  .svc-lead { position: relative; margin: clamp(28px, 4vh, 44px) 0 0; max-width: 620px; font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.6; color: rgba(255,243,224,.82); }

  .promise { position: relative; list-style: none; padding: 0; margin: clamp(56px, 9vh, 96px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .promise-cable { position: absolute; left: 0; right: 0; top: 22px; width: 100%; height: 40px; overflow: visible; }
  .pc-draw { stroke-dasharray: 1; stroke-dashoffset: 0; }
  html.js .pc-draw { stroke-dashoffset: 1; }
  .pr { position: relative; }
  .pr-icon {
    position: relative; z-index: 1; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%;
    background: var(--color-cream); color: var(--color-ink); border: 3px solid var(--color-ink); box-shadow: 0 5px 0 var(--color-red);
  }
  .pr-svg { width: 44px; height: 44px; overflow: visible; }
  .pr-pin { width: 36px; height: 46px; }
  .pr-n { display: block; margin-top: 22px; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 12px; letter-spacing: .18em; color: var(--color-coral); }
  .pr-title { margin: 8px 0 0; font-size: clamp(1.35rem, 1.9vw, 1.75rem); }
  .pr-body { margin: 10px 0 0; max-width: 320px; font-size: 15px; line-height: 1.6; color: rgba(255,243,224,.75); }
  @media (max-width: 760px) {
    .promise { grid-template-columns: 1fr; gap: 34px; }
    .promise-cable { display: none; }
    .pr { display: grid; grid-template-columns: 76px 1fr; column-gap: 18px; align-items: start; }
    .pr-icon { width: 72px; height: 72px; grid-row: span 3; border-width: 3px; box-shadow: 0 5px 0 var(--color-red); }
    .pr-svg { width: 38px; height: 38px; } .pr-pin { width: 32px; height: 40px; }
    .pr-n { margin-top: 4px; }
    .pr-title { margin-top: 2px; }
  }

  /* ── B. Haul: full-screen classroom ── */
  .haul { position: relative; background: var(--color-ink); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .room {
    --gut: clamp(16px, 4vw, 48px);
    --road-h: clamp(46px, 7svh, 68px);
    --van-w: clamp(220px, min(24vw, 42svh), 380px);
    --van-l: 6%;
    position: relative; overflow: hidden; height: 100svh; display: flex; flex-direction: column; align-items: center;
    padding-top: clamp(80px, 11svh, 104px);
    background: var(--color-cream); color: var(--color-ink); border-radius: 36px 36px 0 0;
  }
  .room-dots {
    position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(circle, rgba(17,17,17,.11) 0 3px, transparent 3.5px); background-size: 30px 30px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%); mask-image: linear-gradient(180deg, transparent, #000 30%);
  }

  /* the chalkboard carries the headline */
  .board {
    position: relative; flex: none; width: min(1180px, calc(100% - var(--gut) * 2)); padding: clamp(16px, 2.6svh, 28px) clamp(18px, 2.4vw, 34px) 0;
    background: var(--color-ink); color: var(--color-cream); border-radius: 24px; box-shadow: 7px 7px 0 var(--color-red);
  }
  .board::after {
    content: ""; position: absolute; left: 8%; right: 8%; bottom: -12px; height: 9px; border-radius: 0 0 8px 8px; background: #2A2A2A; border: 3px solid var(--color-ink); border-top: 0;
  }
  .haul-kicker { margin: 0; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-coral); }
  .haul-title { margin: 10px 0 0; font-size: clamp(2rem, min(3.8vw, 6.4svh), 3.7rem); line-height: 1.02; }
  .haul-title em { font-style: normal; color: var(--color-red); text-shadow: 0 .05em 0 var(--color-red-dark); }
  .board-row {
    display: flex; align-items: center; gap: 12px; margin-top: clamp(14px, 2.2svh, 22px); padding: clamp(10px, 1.6svh, 14px) 0;
    border-top: 2px dashed rgba(255,243,224,.22);
  }
  .rb-week { flex: none; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; background: var(--color-red); padding: 5px 10px; border-radius: 999px; white-space: nowrap; }
  .rb-task { min-width: 0; font-family: var(--font-display); font-size: clamp(14px, 1.4vw, 19px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgba(255,243,224,.85); }
  .rb-dot { margin-left: auto; width: 10px; height: 10px; flex: none; border-radius: 50%; background: #5FD38D; box-shadow: 0 0 0 4px rgba(95,211,141,.25); animation: beacon 1.2s steps(2) infinite; }

  /* cargo lands in the middle of the room */
  .cargo-grid {
    position: relative; flex: 1; min-height: 0; width: min(1180px, calc(100% - var(--gut) * 2)); margin-top: clamp(24px, 4svh, 44px);
    display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: minmax(0, 1fr); align-items: center; gap: clamp(10px, 1.4vw, 18px);
  }
  .cargo {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; height: 100%; max-height: 280px; min-height: 0; padding: 12px 8px 14px;
    background: #FFF8EC; border: 3px solid var(--color-ink); border-radius: 20px; box-shadow: 0 6px 0 var(--color-ink); will-change: transform;
  }
  html.js .cargo { opacity: 0; }
  .cargo-art { position: relative; flex: 1; min-height: 0; width: 100%; margin-bottom: 4px; }
  .ca-svg { position: absolute; inset: 4% 8%; width: 84%; height: 92%; overflow: visible; }
  .ca-tutor { color: var(--color-ink); }
  .cargo-label { font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: clamp(10px, .9vw, 13px); letter-spacing: .08em; text-transform: uppercase; text-align: center; line-height: 1.2; }
  .cargo-sub { font-size: 12px; line-height: 1.3; text-align: center; color: rgba(17,17,17,.6); }

  /* the road runs the full width of the screen */
  .room-floor { position: relative; flex: none; width: 100%; height: calc(var(--van-w) * .56 + var(--road-h) * .5 + 12px); }
  .haul-road { position: absolute; left: 0; right: 0; bottom: 0; height: var(--road-h); background: var(--color-ink); border-top: 6px solid var(--color-red); }
  .haul-dash { position: absolute; left: 0; right: 0; top: 50%; height: 4px; translate: 0 -50%; background-image: linear-gradient(90deg, var(--color-cream) 0 28px, transparent 28px 56px); background-size: 56px 4px; opacity: .7; }
  .haul-van { position: absolute; left: var(--van-l); bottom: calc(var(--road-h) * .5); width: var(--van-w); }
  .haul-van-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .haul-van .vw-speed { stroke: var(--color-ink); }
  .haul-van .vw-beam { display: none; }
  .haul-van .vw-beacon { animation: beacon .8s steps(2) infinite; }
  .puff { position: absolute; left: calc(var(--van-l) - 3%); bottom: calc(var(--road-h) * .5 + var(--van-w) * .18); width: calc(var(--van-w) * .32); aspect-ratio: 1; }
  .puff span { position: absolute; border-radius: 50%; background: var(--color-cream); border: 3px solid var(--color-ink); opacity: 0; }
  .puff span:nth-child(1) { width: 60%; height: 60%; left: 0; top: 20%; }
  .puff span:nth-child(2) { width: 46%; height: 46%; left: 40%; top: 0; }
  .puff span:nth-child(3) { width: 36%; height: 36%; left: 52%; top: 52%; }

  .haul-foot {
    position: absolute; z-index: 2; right: var(--gut); bottom: calc(var(--road-h) + 22px); margin: 0; padding: 14px 20px; border-radius: 16px;
    background: var(--color-red); color: var(--color-cream); border: 3px solid var(--color-ink); box-shadow: 0 6px 0 var(--color-ink);
    font-weight: 600; font-size: 16px; line-height: 1.35; rotate: -2deg;
  }
  .haul-foot b { font-family: var(--font-label); font-weight: 900; font-stretch: 125%; letter-spacing: .06em; text-transform: uppercase; }
  html.js .haul-foot { opacity: 0; }

  @media (max-width: 899px) {
    .room {
      --gut: 16px; --road-h: 60px; --van-w: clamp(118px, min(38vw, 24svh), 200px); --van-l: 3%;
      padding-top: 80px; border-radius: 26px 26px 0 0;
    }
    .board { padding: 16px 16px 0; border-radius: 18px; box-shadow: 5px 5px 0 var(--color-red); }
    .board::after { bottom: -10px; height: 7px; }
    .haul-kicker { font-size: 10.5px; letter-spacing: .16em; }
    .haul-title { margin-top: 8px; font-size: clamp(1.65rem, min(8.4vw, 4.6svh), 2.5rem); }
    .board-row { gap: 8px; margin-top: 12px; padding: 9px 0 11px; }
    .rb-week { font-size: 9.5px; padding: 4px 8px; }
    .rb-task { font-size: clamp(11px, 3.3vw, 14px); }
    .cargo-grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, minmax(0, 1fr)); align-content: center; gap: 10px; margin-top: clamp(20px, 3.4svh, 32px); padding-bottom: 10px; }
    .cargo { max-height: 190px; padding: 8px 6px 10px; border-radius: 14px; border-width: 2.5px; box-shadow: 0 4px 0 var(--color-ink); }
    .cargo-label { font-size: clamp(8.5px, 2.4vw, 10.5px); letter-spacing: .05em; }
    .cargo-sub { display: none; }
    .room-floor { height: calc(var(--road-h) + max(var(--van-w) * .56 - var(--road-h) * .5, 84px) + 10px); }
    .haul-foot {
      right: 12px; bottom: calc(var(--road-h) + 12px); max-width: calc(100% - var(--van-w) - 3% - 30px);
      padding: 8px 11px 9px; border-radius: 12px; border-width: 2.5px; box-shadow: 0 4px 0 var(--color-ink); font-size: clamp(10.5px, 3vw, 13px); line-height: 1.3; white-space: nowrap;
    }
    .haul-foot b { letter-spacing: .02em; }
    .haul-foot span { display: block; }
  }
  @media (max-width: 899px) and (max-height: 640px) {
    .room { padding-top: 76px; }
    .haul-kicker, .board-row { display: none; }
    .haul-title { margin-top: 0; padding-bottom: 14px; }
    .cargo-label { font-size: 8px; }
  }

  /* ── C. Programs staircase ── */
  .prog { position: relative; background: var(--color-red); color: var(--color-cream); overflow: clip; }
  /* same slow-turning sunburst as the hero, held behind the viewport while the section scrolls */
  .prog-bg { position: absolute; inset: 0; pointer-events: none; }
  .prog-sun { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .prog-rays {
    position: absolute; left: 50%; top: 47%; width: 260vmax; height: 260vmax; translate: -50% -50%; border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, #E3121B 0deg 6.6deg, #C70E17 7.4deg 14.2deg, #E3121B 15deg);
    animation: rays-spin 90s linear infinite;
  }
  .prog-glow {
    position: absolute; left: 50%; top: 47%; width: 70vmax; height: 70vmax; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 96, 70, .55), rgba(227, 18, 27, .25) 38%, transparent 68%);
    animation: rays-breathe 5s ease-in-out infinite alternate;
  }
  .prog-shade { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 47%, transparent 35%, rgba(110, 0, 8, .45)); }
  @keyframes rays-spin { to { transform: rotate(360deg); } }
  @keyframes rays-breathe { from { transform: scale(.85); opacity: .7; } to { transform: scale(1.12); opacity: 1; } }
  .prog-in { position: relative; padding-top: clamp(80px, 12vh, 130px); padding-bottom: clamp(80px, 12vh, 130px); }
  .prog-head { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 24px 56px; }
  .prog-kicker { margin: 0; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-ink); }
  .prog-title { margin: 12px 0 0; font-size: clamp(2.2rem, 4.4vw, 3.8rem); line-height: 1.02; text-shadow: 0 .05em 0 var(--color-red-dark); }
  .prog-title em { font-style: normal; color: var(--color-ink); text-shadow: none; }
  .prog-intro { margin: 0; max-width: 440px; font-size: 16px; line-height: 1.6; color: rgba(255,243,224,.9); }

  .stairs {
    position: relative; margin-top: clamp(40px, 6vh, 64px); display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: end;
    clip-path: inset(-200px -60px 0 -60px);
  }
  .stp { position: relative; display: flex; flex-direction: column; }
  .stp-top { position: relative; display: flex; align-items: flex-end; justify-content: space-between; height: 56px; padding-inline: 4px; }
  .stp-no { font-family: var(--font-display); font-size: 44px; line-height: 1; color: var(--color-red-dark); }
  .summit { position: relative; display: block; width: 110px; height: 96px; margin-bottom: -2px; }
  .summit-pole { position: absolute; left: 10px; bottom: 0; width: 5px; height: 96px; border-radius: 3px; background: var(--color-ink); }
  .summit-flag {
    position: absolute; left: 15px; top: 4px; padding: 6px 12px 8px; border-radius: 0 8px 8px 0; background: var(--color-cream); color: var(--color-red);
    border: 3px solid var(--color-ink); font-family: var(--font-display); font-size: 17px; line-height: 1; transform-origin: 0 50%; animation: flag 1.4s ease-in-out infinite alternate;
  }
  @keyframes flag { from { transform: skewY(-3deg) scaleX(.96); } to { transform: skewY(3deg) scaleX(1); } }

  .stp-card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--color-cream); color: var(--color-ink); border: 3px solid var(--color-ink); border-radius: 22px 22px 0 0; border-bottom: 0;
    box-shadow: 8px 0 0 var(--color-ink);
  }
  .stp-1 .stp-card { min-height: 470px; }
  .stp-2 .stp-card { min-height: 530px; }
  .stp-3 .stp-card { min-height: 590px; }
  .stp-art {
    position: relative; height: 156px; flex: none; display: grid; place-items: center; padding: 18px 22px 10px;
    background-image: radial-gradient(circle, rgba(17,17,17,.1) 0 2.5px, transparent 3px); background-size: 22px 22px;
    border-bottom: 3px dashed rgba(17,17,17,.15);
  }
  .stp-art .lvl-svg { position: absolute; left: 20px; top: 16px; width: calc(100% - 40px); height: calc(100% - 26px); overflow: visible; }
  .stp-copy { flex: 1; display: flex; flex-direction: column; padding: 18px 22px 22px; }

  .lvl-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .lvl-name, .lvl-grades { font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; }
  .lvl-name { background: var(--color-red); color: #fff; }
  .lvl-grades { border: 2px solid var(--color-ink); }
  .lvl-title { margin: 12px 0 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.35rem, 1.9vw, 1.75rem); line-height: 1.08; }
  .lvl-body { margin: 8px 0 0; font-size: 14.5px; line-height: 1.55; }
  .lvl-sub { margin: 16px 0 0; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-red); }
  .lvl-builds { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .lvl-builds li { padding: 5px 10px; border-radius: 8px; background: #FFF8EC; border: 2px solid var(--color-ink); font-weight: 600; font-size: 12.5px; box-shadow: 0 2px 0 var(--color-ink); }
  .lvl-foot { margin-top: auto; padding-top: 14px; border-top: 2px dashed rgba(17,17,17,.2); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .lvl-builds + .lvl-foot { margin-top: auto; }
  .stp-copy .lvl-builds { margin-bottom: 18px; }
  .lvl-tools { font-weight: 600; font-size: 13px; }
  .lvl-meter { display: flex; gap: 4px; }
  .lvl-meter i { width: 18px; height: 8px; border-radius: 3px; border: 2px solid var(--color-ink); }
  .lvl-meter i.on { background: var(--color-red); }

  /* grade axis: the floor of the staircase */
  .axis { position: relative; }
  .axis-bar { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 0; background: var(--color-ink); border-radius: 0 0 14px 14px; box-shadow: 8px 6px 0 var(--color-red-dark); }
  .axis-fill { position: absolute; left: 0; top: 0; height: 4px; width: 100%; background: var(--color-cream); transform-origin: 0 50%; }
  html.js .axis-fill { transform: scaleX(0); }
  .axis-seg { display: flex; justify-content: space-around; padding: 14px 8px 12px; }
  .ax-g { font-family: var(--font-display); font-size: 17px; line-height: 1; color: rgba(255,243,224,.3); transition: color .25s, scale .25s; }
  .ax-g.on { color: var(--color-cream); }
  html:not(.js) .ax-g { color: var(--color-cream); }
  .axis-label { display: block; margin-top: 14px; text-align: right; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-ink); }

  /* level art idle loops */
  .lv-glow { opacity: .55; filter: blur(14px); transform-box: fill-box; transform-origin: center; animation: lv-glow 1.6s ease-in-out infinite alternate; }
  @keyframes lv-glow { from { opacity: .25; transform: scale(.75); } to { opacity: .75; transform: scale(1.1); } }
  .lv-btn { transform-box: fill-box; transform-origin: center; animation: lv-press 1.6s ease-in-out infinite; }
  @keyframes lv-press { 0%, 70%, 100% { transform: scale(1); } 80% { transform: scale(.78); } }
  .lv-wheel { transform-box: fill-box; transform-origin: center; animation: spin 1s linear infinite; }
  .lv-car { animation: lv-car 3.2s ease-in-out infinite; }
  @keyframes lv-car { 0%, 100% { transform: translateX(-14px); } 50% { transform: translateX(10px); } }
  .lv-wave { opacity: 0; animation: lv-wave 1.4s ease-out infinite; }
  .lv-wave:nth-child(2) { animation-delay: .2s; } .lv-wave:nth-child(3) { animation-delay: .4s; }
  @keyframes lv-wave { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
  .lv-blink { animation: beacon .8s steps(2) infinite; }
  .lv-arm1 { transform-box: view-box; transform-origin: 90px 196px; animation: lv-arm1 3s ease-in-out infinite alternate; }
  .lv-arm2 { transform-box: view-box; transform-origin: 90px 104px; animation: lv-arm2 3s ease-in-out infinite alternate; }
  @keyframes lv-arm1 { from { transform: rotate(-12deg); } to { transform: rotate(16deg); } }
  @keyframes lv-arm2 { from { transform: rotate(-18deg); } to { transform: rotate(26deg); } }
  .lv-caret { animation: beacon 1s steps(2) infinite; }
  .lv-wifi path { animation: lv-wave 1.6s ease-out infinite; }
  .lv-wifi path:nth-child(2) { animation-delay: .25s; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes beacon { 50% { opacity: .2; } }

  /* outcome */
  .prog-out {
    margin-top: clamp(56px, 9vh, 96px); display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center;
    padding: clamp(22px, 3vw, 36px); background: var(--color-ink); color: var(--color-cream); border-radius: 26px; box-shadow: 8px 8px 0 var(--color-red-dark);
  }
  .out-photos { position: relative; height: clamp(260px, 30vw, 360px); }
  .out-ph { position: absolute; margin: 0; border: 3px solid var(--color-cream); border-radius: 16px; overflow: hidden; background: #333; }
  .out-ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .out-ph-1 { left: 0; top: 0; width: 80%; height: 68%; rotate: -2.5deg; }
  .out-ph-2 { right: 0; bottom: 0; width: 62%; height: 52%; rotate: 3deg; box-shadow: -6px 6px 0 var(--color-red); }
  .out-stamp {
    position: absolute; right: 4%; top: 2%; width: 78px; height: 78px; border-radius: 50%; display: grid; place-items: center; text-align: center;
    background: var(--color-red); color: var(--color-cream); border: 3px solid var(--color-cream); font-family: var(--font-display); font-size: 15px; line-height: .95; rotate: 12deg;
  }
  .out-copy .lvl-sub { color: var(--color-coral); margin-top: 0; }
  .out-title { margin: 10px 0 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.3rem); line-height: 1.06; }
  .out-list { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 10px; }
  .out-list li { position: relative; padding-left: 24px; font-size: 15px; line-height: 1.5; color: rgba(255,243,224,.78); }
  .out-list li::before { content: "✦"; position: absolute; left: 0; top: 0; color: var(--color-red); }
  .out-list b { color: var(--color-cream); font-weight: 600; }

  @media (max-width: 899px) {
    .prog-head { grid-template-columns: 1fr; }
    .prog-intro { font-size: 15px; }
    .stairs { grid-template-columns: 1fr; gap: 14px; clip-path: none; }
    .stp-2 { margin-left: 5%; } .stp-3 { margin-left: 10%; }
    .stp-top { height: 44px; }
    .stp-no { font-size: 34px; }
    .summit { width: 96px; height: 70px; } .summit-pole { height: 70px; } .summit-flag { font-size: 14px; }
    .stp-card, .stp-1 .stp-card, .stp-2 .stp-card, .stp-3 .stp-card { min-height: 0; border-radius: 18px; border-bottom: 3px solid var(--color-ink); box-shadow: 5px 5px 0 var(--color-ink); }
    .stp-art { height: 140px; }
    .axis { display: none; }
    .prog-out { grid-template-columns: 1fr; }
    .out-photos { height: 240px; }
  }

  /* ── D. Ways ── */
  .ways { position: relative; background: var(--color-cream); color: var(--color-ink); }
  .ways-in { padding-top: clamp(80px, 13vh, 140px); padding-bottom: clamp(80px, 13vh, 140px); }
  .ways-head { display: flex; flex-direction: column; gap: 18px; }
  .ways-title { margin: 0; font-size: clamp(2.1rem, 4.4vw, 3.8rem); line-height: 1.04; max-width: 760px; }
  .ways-title em { white-space: nowrap; font-style: normal; color: var(--color-red); text-shadow: 0 .05em 0 var(--color-red-dark); }
  .ways-grid { margin-top: clamp(40px, 7vh, 70px); display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; perspective: 1200px; }
  .way { position: relative; }
  .way-tilt {
    height: 100%; display: flex; flex-direction: column; overflow: hidden;
    background: #FFF8EC; border: 3px solid var(--color-ink); border-radius: 22px; box-shadow: 0 7px 0 var(--color-ink);
    transform-style: preserve-3d; transition: box-shadow .25s;
  }
  .way:hover .way-tilt { box-shadow: 0 11px 0 var(--color-red); }
  .way-dark .way-tilt { background: var(--color-ink); color: var(--color-cream); box-shadow: 0 7px 0 var(--color-red); }
  .way-dark:hover .way-tilt { box-shadow: 0 11px 0 var(--color-red); }
  .way-ph { position: relative; margin: 0; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 3px solid var(--color-ink); }
  .way-dark .way-ph { border-bottom-color: var(--color-red); }
  .way-ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: scale .5s cubic-bezier(.2,.7,.2,1); }
  .way:hover .way-ph img { scale: 1.06; }
  .way-tag {
    position: absolute; left: 14px; top: 14px; padding: 7px 12px; border-radius: 999px; background: var(--color-cream); color: var(--color-ink); border: 2.5px solid var(--color-ink);
    font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;
  }
  .way-dark .way-tag { background: var(--color-red); color: #fff; }
  .way-body { flex: 1; display: flex; flex-direction: column; padding: 24px 24px 26px; }
  .way-title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.4rem, 1.8vw, 1.7rem); line-height: 1.08; }
  .way-text { margin: 10px 0 0; font-size: 14.5px; line-height: 1.55; }
  .way-dark .way-text { color: rgba(255,243,224,.8); }
  .way-items { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 9px; }
  .way-items li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; font-weight: 500; font-size: 13.5px; line-height: 1.45; }
  .way-items svg { width: 22px; height: 22px; padding: 3px; border-radius: 7px; background: var(--color-red); color: #fff; }
  .way-best { margin: auto 0 0; padding-top: 18px; font-size: 13.5px; line-height: 1.45; }
  .way-best span { display: block; margin-bottom: 4px; font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-red); }
  .way-dark .way-best span { color: var(--color-coral); }
  .way-best { border-top: 3px dashed rgba(17,17,17,.18); margin-top: 22px; }
  .way-dark .way-best { border-top-color: rgba(255,243,224,.2); }
  .ways-cta { margin-top: 56px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; padding: 22px 26px; border-radius: 22px; background: var(--color-red); color: var(--color-cream); box-shadow: 0 7px 0 var(--color-red-dark); }
  .ways-cta p { margin: 0; font-family: var(--font-display); font-size: clamp(1.1rem, 1.7vw, 1.45rem); line-height: 1.2; }
  .ways-btn {
    display: inline-block; padding: 14px 24px; border-radius: 999px; background: var(--color-cream); color: var(--color-ink); text-decoration: none;
    font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; box-shadow: 0 5px 0 var(--color-ink);
    transition: translate .15s, box-shadow .15s;
  }
  .ways-btn:hover { translate: 0 -2px; box-shadow: 0 7px 0 var(--color-ink); }
  .ways-btn:focus-visible, .way:focus-within .way-tilt { outline: 3px solid var(--color-ink); outline-offset: 4px; }

  @media (max-width: 980px) {
    .ways-grid { grid-template-columns: 1fr; max-width: 560px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lv-glow, .lv-btn, .lv-wheel, .lv-car, .lv-wave, .lv-blink, .lv-arm1, .lv-arm2, .lv-caret, .lv-wifi path, .haul-van .vw-beacon, .prog-rays, .prog-glow { animation: none !important; }
    .lv-wave, .lv-wifi path { opacity: 1; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion, finePointer } from "../scripts/motion";

  const svc = document.querySelector<HTMLElement>(".svc")!;
  const q = gsap.utils.selector(svc);

  const showFinal = () => {
    gsap.set(q(".pc-draw"), { strokeDashoffset: 0 });
    gsap.set(q(".cargo, .haul-foot"), { opacity: 1 });
    gsap.set(q(".axis-fill"), { scaleX: 1 });
    q(".ax-g").forEach((t) => t.classList.add("on"));
  };

  if (reducedMotion) {
    showFinal();
  } else {
    // ── A. Intro ──
    gsap.timeline({ scrollTrigger: { trigger: ".svc-h", start: "top 90%", end: "top 40%", scrub: 0.8 } })
      .from(q(".svc-hw"), { yPercent: 110, rotate: (i: number) => [-12, 10, -8][i], opacity: 0, stagger: 0.12, ease: "back.out(1.8)", duration: 0.5 }, 0)
      .from(q(".svc-h-2"), { xPercent: -60, rotate: -20, scale: 0.5, opacity: 0, ease: "back.out(2)", duration: 0.5 }, 0.35);
    gsap.from(q(".svc-lead"), { y: 40, opacity: 0, ease: "none", scrollTrigger: { trigger: ".svc-lead", start: "top 92%", end: "top 70%", scrub: 0.6 } });
    gsap.fromTo(q(".svc-grid-bg"), { y: 60 }, { y: -60, ease: "none", scrollTrigger: { trigger: ".svc-intro", start: "top bottom", end: "bottom top", scrub: true } });

    gsap.timeline({ scrollTrigger: { trigger: ".promise", start: "top 85%", end: "bottom 60%", scrub: 0.8 } })
      .to(q(".pc-draw"), { strokeDashoffset: 0, duration: 1, ease: "none" }, 0)
      .from(q(".pr-icon"), { scale: 0, rotate: -40, duration: 0.3, ease: "back.out(2.4)", stagger: 0.33 }, 0)
      .from(q(".pr-n, .pr-title, .pr-body"), { y: 30, opacity: 0, duration: 0.3, stagger: 0.04 }, 0.05);

    // ── B. Haul: van drives in, cargo flies out into the classroom ──
    const room = q(".room")[0];
    const van = q(".haul-van")[0];
    const cargo = q(".cargo");

    // Offset from a cargo tile's resting spot to the back of the van (layout-based, unaffected by transforms).
    const offsetIn = (el: HTMLElement) => {
      let x = 0, y = 0, n: HTMLElement | null = el;
      while (n && n !== room) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
      return { x, y };
    };
    const fromVan = (el: HTMLElement) => {
      const t = offsetIn(el);
      const v = offsetIn(van);
      return { x: v.x + van.offsetWidth * 0.3 - (t.x + el.offsetWidth / 2), y: v.y + van.offsetHeight * 0.4 - (t.y + el.offsetHeight / 2) };
    };

    const mm = gsap.matchMedia();
    mm.add({ mobile: "(max-width: 899px)", desktop: "(min-width: 900px)" }, (ctx) => {
      const { mobile } = ctx.conditions as { mobile: boolean };

      const haul = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: { trigger: ".haul", start: "top top", end: mobile ? "+=200%" : "+=260%", scrub: 1, pin: ".haul-pin", anticipatePin: 1, invalidateOnRefresh: true },
      });
      haul
        .fromTo(q(".haul-van-in"), { x: () => -room.clientWidth * 0.75 }, { x: 0, duration: 0.9, ease: "power2.out" }, 0)
        .fromTo(q(".haul-van .vw-wheel"), { rotation: -900 }, { rotation: 0, transformOrigin: "50% 50%", duration: 0.9, ease: "power2.out" }, 0)
        .fromTo(q(".haul-van .vw-speed"), { opacity: 1 }, { opacity: 0, duration: 0.2 }, 0.75)
        .to(q(".haul-van-in"), { rotate: -3, transformOrigin: "85% 100%", duration: 0.1, yoyo: true, repeat: 1, ease: "power1.out" }, 0.88)
        .fromTo(q(".puff span"), { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.15, stagger: 0.04, ease: "back.out(3)" }, 0.95)
        .to(q(".puff span"), { scale: 1.4, opacity: 0, duration: 0.25, stagger: 0.04 }, 1.15);

      cargo.forEach((el, i) => {
        const at = 1.05 + i * 0.42;
        haul
          .fromTo(el,
            { x: () => fromVan(el).x, y: () => fromVan(el).y, scale: 0.15, rotate: gsap.utils.random(-50, 50), opacity: 0 },
            { x: 0, y: 0, scale: 1, rotate: 0, opacity: 1, duration: 0.5, ease: "back.out(1.5)", immediateRender: false }, at);
      });
      haul
        .fromTo(q(".haul-foot"), { opacity: 0, y: 20, scale: 0.85 }, { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(2)" }, 3.75)
        .to({}, { duration: 0.5 });

      // ── C. Programs: steps rise out of the floor, the grade axis fills ──
      const ticks = q(".ax-g");
      if (!mobile) {
        const stairs = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: ".stairs", start: "top 85%", end: "bottom 80%", scrub: 0.8, invalidateOnRefresh: true,
            onUpdate: (self) => {
              const lit = Math.round(self.progress * ticks.length);
              ticks.forEach((t, k) => t.classList.toggle("on", k < lit));
            },
          },
        });
        q(".stp").forEach((stp, i) => {
          const card = stp.querySelector<HTMLElement>(".stp-card")!;
          const at = i * 0.4;
          stairs
            .fromTo(card, { y: () => card.offsetHeight + 30 }, { y: 0, duration: 0.6, ease: "power3.out" }, at)
            .from(stp.querySelector(".stp-no"), { y: 50, opacity: 0, duration: 0.3, ease: "back.out(2)" }, at + 0.3)
            .from(stp.querySelector(".lvl-svg"), { scale: 0.3, rotate: -10, opacity: 0, transformOrigin: "50% 100%", duration: 0.35, ease: "back.out(2)" }, at + 0.4)
            .from(stp.querySelectorAll(".lvl-builds li"), { y: 14, opacity: 0, duration: 0.2, stagger: 0.04 }, at + 0.45);
        });
        stairs
          .fromTo(q(".axis-fill"), { scaleX: 0 }, { scaleX: 1, duration: 1.5 }, 0)
          .from(q(".summit"), { scale: 0, y: 120, transformOrigin: "12px 100%", duration: 0.35, ease: "back.out(2)" }, 1.25);
      } else {
        q(".stp").forEach((stp, i) => {
          gsap.from(stp, { y: 70, x: 20 * i, opacity: 0, ease: "none", scrollTrigger: { trigger: stp, start: "top 95%", end: "top 65%", scrub: 0.6 } });
        });
      }
      gsap.from(q(".prog-title, .prog-intro"), { y: 40, opacity: 0, stagger: 0.1, ease: "none", scrollTrigger: { trigger: ".prog-head", start: "top 90%", end: "top 55%", scrub: 0.6 } });
      gsap.timeline({ scrollTrigger: { trigger: ".prog-out", start: "top 92%", end: "top 45%", scrub: 0.8 } })
        .from(q(".prog-out"), { y: 80, rotate: -1.5, opacity: 0, ease: "power2.out", duration: 0.6 }, 0)
        .from(q(".out-ph-1"), { x: -60, rotate: -12, opacity: 0, duration: 0.5, ease: "back.out(1.6)" }, 0.2)
        .from(q(".out-ph-2"), { x: 60, rotate: 14, opacity: 0, duration: 0.5, ease: "back.out(1.6)" }, 0.3)
        .from(q(".out-stamp"), { scale: 0, rotate: -90, duration: 0.4, ease: "back.out(2.5)" }, 0.45)
        .from(q(".out-list li"), { x: 30, opacity: 0, stagger: 0.06, duration: 0.3 }, 0.35);

      // ── D. Ways: cards deal out of one stack ──
      if (!mobile) {
        gsap.from(q(".way"), {
          x: (i: number, el: HTMLElement) => (1 - i) * (el.offsetWidth + 24),
          y: 160, rotate: (i: number) => [-9, 3, 10][i], ease: "power2.out",
          scrollTrigger: { trigger: ".ways-grid", start: "top 95%", end: "top 35%", scrub: 1, invalidateOnRefresh: true },
        });
      } else {
        q(".way").forEach((el, i) => {
          gsap.from(el, { y: 90, rotate: i % 2 ? 4 : -4, opacity: 0, ease: "none", scrollTrigger: { trigger: el, start: "top 98%", end: "top 65%", scrub: 0.6 } });
        });
      }

    });

    gsap.from(q(".ways-title"), { y: 60, opacity: 0, ease: "none", scrollTrigger: { trigger: ".ways-title", start: "top 95%", end: "top 60%", scrub: 0.6 } });
    gsap.from(q(".ways-cta"), { y: 50, scale: 0.94, opacity: 0, ease: "none", scrollTrigger: { trigger: ".ways-cta", start: "top 98%", end: "top 75%", scrub: 0.6 } });

    // Pointer tilt on the way cards
    if (finePointer) {
      q(".way").forEach((card) => {
        const tilt = card.querySelector<HTMLElement>(".way-tilt")!;
        const rx = gsap.quickTo(tilt, "rotationX", { duration: 0.5, ease: "power3" });
        const ry = gsap.quickTo(tilt, "rotationY", { duration: 0.5, ease: "power3" });
        const ty = gsap.quickTo(tilt, "y", { duration: 0.5, ease: "power3" });
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          ry(((e.clientX - r.left) / r.width - 0.5) * 10);
          rx(-((e.clientY - r.top) / r.height - 0.5) * 8);
          ty(-8);
        });
        card.addEventListener("pointerleave", () => { rx(0); ry(0); ty(0); });
      });
    }
  }
</script>
