---
/* Site footer, drawn like a powered circuit board (same design as the simulator's footer):
   - the pin-hole grid lights up around the pointer (--mx/--my, set by the script below)
   - each link has an LED and a wire that carries current on hover
   - the stemGRID wordmark lights letter by letter once when it scrolls into view, then under the pointer */
import { PHONE, SIMULATOR_HOME } from "../lib/site";

const pageLinks = [
  { href: "#who", label: "Who we are" },
  { href: "#services", label: "What we do" },
  { href: "#programs", label: "Programs" },
  { href: "#kit", label: "Quark Kit" },
];
const stem = "stem".split("");
const grid = "GRID".split("");
const year = new Date().getFullYear();
---
<footer id="footer" class="ft" data-ft>
  <div class="ft-grid" aria-hidden="true"></div>
  <div class="ft-lit" aria-hidden="true"></div>

  <div class="ft-in">
    <!-- last call -->
    <div class="ft-call">
      <h2 class="ft-call-h">Ready to put your school on the grid?</h2>
      <div class="ft-call-side">
        <p>Call us to book a free demo for your school, or to ask which program fits your grades.</p>
        <a class="ft-cta" href={PHONE.href}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.1 6.1l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" fill="currentColor" /></svg>
          {PHONE.label}
        </a>
      </div>
    </div>

    <!-- links -->
    <div class="ft-cols">
      <div class="ft-brand">
        <a href="#top" class="ft-logo" aria-label="StemGrid home">
          <img class="ft-img" src="/stemgrid-logo.png" alt="StemGrid Tech Labs" width="640" height="287" loading="lazy" />
        </a>
        <p>Real electronics, coding and robotics for schools, with plug-and-play Quark Kits, trained tutors and Lab on Wheels.</p>
      </div>

      <nav aria-labelledby="ft-page">
        <h3 id="ft-page" class="ft-col-h">On this page</h3>
        <ul class="ft-list">
          {pageLinks.map((l) => (
            <li><a class="ft-link" href={l.href}><i class="ft-led" aria-hidden="true"></i><span class="ft-wire" aria-hidden="true"></span>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="ft-more">
        <h3 id="ft-more" class="ft-col-h">Get in touch</h3>
        <ul class="ft-list">
          <li><a class="ft-link" href={PHONE.href}><i class="ft-led" aria-hidden="true"></i><span class="ft-wire" aria-hidden="true"></span>{PHONE.label}</a></li>
          <li>
            <a class="ft-link" href={SIMULATOR_HOME}><i class="ft-led" aria-hidden="true"></i><span class="ft-wire" aria-hidden="true"></span>Simulator
              <svg class="ft-out" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </li>
        </ul>
      </nav>

      <a class="ft-sim" href={SIMULATOR_HOME}>
        <span class="ft-sim-top">Simulator</span>
        <span class="ft-sim-body">Build and code the Quark Kit in your browser. Free, no sign-up.</span>
        <span class="ft-sim-go">Try it now</span>
      </a>
    </div>

    <!-- the wordmark: hover the letters -->
    <p class="ft-word" aria-label="StemGrid" data-ft-word>
      {stem.map((c, i) => <span class="w-stem" style={`--i:${i}`} aria-hidden="true">{c}</span>)}
      {grid.map((c, i) => <span class="w-grid" style={`--i:${i + stem.length}`} aria-hidden="true">{c}</span>)}
    </p>

    <div class="ft-bar">
      <p>© {year} StemGrid. All rights reserved.</p>
      <a href="#top" class="ft-top" data-ft-top>
        Back to top
        <span class="ft-top-btn" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
        </span>
      </a>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector<HTMLElement>("[data-ft]");
  const word = document.querySelector<HTMLElement>("[data-ft-word]");
  if (el && word) {
    let raf = 0, x = 0, y = 0, inside = false;
    const draw = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${x - r.left}px`);
        el.style.setProperty("--my", `${y - r.top}px`);
      });
    };
    el.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      x = e.clientX; y = e.clientY; inside = true;
      el.style.setProperty("--glow", "1");
      draw();
    });
    el.addEventListener("pointerleave", () => { inside = false; el.style.setProperty("--glow", "0"); });
    addEventListener("scroll", () => { if (inside) draw(); }, { passive: true }); // the page moves under a still pointer

    const io = new IntersectionObserver(([en]) => {
      if (en.isIntersecting) { word.dataset.on = ""; io.disconnect(); }
    }, { threshold: 0.6 });
    io.observe(word);

    document.querySelector("[data-ft-top]")?.addEventListener("click", (e) => {
      e.preventDefault();
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
    });
  }
</script>

<style>
  .ft {
    --mx: 50%; --my: 50%; --glow: 0;
    position: relative; overflow: hidden;
    background: var(--color-ink); color: rgba(255, 243, 224, .72);
    font-family: var(--font-body);
    padding-top: 22px;
  }
  /* cream half pin-holes hanging off the section above */
  .ft::before {
    content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 22px; z-index: 2;
    background: radial-gradient(circle at 50% 0, var(--color-cream) 0 13.5px, transparent 14px) 0 0 / 28px 22px repeat-x;
  }
  .ft a:focus-visible { outline: 3px solid var(--color-cream); outline-offset: 4px; border-radius: 6px; }

  /* pin-hole grid, and a red copy revealed around the pointer */
  .ft-grid, .ft-lit { position: absolute; inset: 0; pointer-events: none; background-size: 28px 28px; background-position: 0 8px; }
  .ft-grid { background-image: radial-gradient(#242424 5px, transparent 6px); }
  .ft-lit {
    background-image: radial-gradient(var(--color-red) 5px, transparent 6px);
    -webkit-mask-image: radial-gradient(240px circle at var(--mx) var(--my), #000 0, rgba(0, 0, 0, .35) 45%, transparent 100%);
    mask-image: radial-gradient(240px circle at var(--mx) var(--my), #000 0, rgba(0, 0, 0, .35) 45%, transparent 100%);
    opacity: calc(var(--glow) * .6); transition: opacity .4s;
  }

  .ft-in { position: relative; width: min(1180px, 100%); margin: 0 auto; padding: clamp(56px, 8vw, 96px) clamp(16px, 4vw, 40px) 28px; }

  /* ---------- last call ---------- */
  .ft-call {
    display: grid; grid-template-columns: 1.35fr 1fr; gap: 28px 56px; align-items: end;
    padding-bottom: clamp(44px, 6vw, 72px); border-bottom: 2px dashed #3a3530;
  }
  .ft-call-h {
    margin: 0; color: var(--color-cream);
    font-family: var(--font-display); font-weight: 400; font-size: clamp(2.2rem, 4.6vw, 4rem); line-height: 1.02;
    text-shadow: 4px 4px 0 var(--color-red-dark);
  }
  .ft-call-side p { margin: 0 0 22px; max-width: 34ch; font-size: 15.5px; line-height: 1.6; }
  .ft-cta {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 26px;
    background: var(--color-cream); color: var(--color-ink); border-radius: 999px;
    box-shadow: 5px 5px 0 var(--color-red); text-decoration: none;
    font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 15px; letter-spacing: .06em;
    transition: transform .15s cubic-bezier(.3, 1.6, .5, 1), box-shadow .15s, background .15s;
  }
  .ft-cta svg { width: 18px; height: 18px; color: var(--color-red); transition: transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .ft-cta:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--color-red); background: #fff; }
  .ft-cta:hover svg { animation: ring .5s ease-in-out; }
  .ft-cta:active { transform: translate(4px, 4px); box-shadow: 1px 1px 0 var(--color-red); transition-duration: .06s; }
  @keyframes ring { 20%, 60% { transform: rotate(-16deg); } 40%, 80% { transform: rotate(16deg); } }

  /* ---------- columns ---------- */
  .ft-cols { display: grid; grid-template-columns: 1.3fr 1fr 1fr auto; gap: 36px 40px; align-items: start; padding: clamp(40px, 5vw, 60px) 0 clamp(16px, 2vw, 28px); }
  .ft-logo { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--color-cream); }
  .ft-logo { padding: 10px 14px; border-radius: 14px; background: var(--color-cream); transition: rotate .35s cubic-bezier(.34, 1.8, .5, 1); }
  .ft-img { display: block; height: 56px; width: auto; }
  .ft-logo:hover { rotate: -3deg; }
  .ft-brand p { margin: 14px 0 0; max-width: 36ch; font-size: 14px; line-height: 1.65; }
  .ft-col-h {
    margin: 0 0 14px; color: var(--color-cream);
    font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
  }

  /* a link is an LED, a wire and a label. Hover powers it */
  .ft-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .ft-link {
    display: inline-flex; align-items: center; padding: 5px 0; white-space: nowrap;
    color: rgba(255, 243, 224, .72); text-decoration: none; font-size: 15px; font-weight: 500;
    transition: color .2s;
  }
  .ft-led { flex: none; width: 10px; height: 10px; border-radius: 50%; border: 2px solid #5a524a; transition: background .2s, border-color .2s, box-shadow .3s; }
  .ft-wire { flex: none; width: 10px; height: 2px; margin-right: 8px; background: #5a524a; transition: width .3s cubic-bezier(.2, .9, .2, 1); }
  .ft-out { width: 12px; height: 12px; margin-left: 6px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; opacity: .55; transition: transform .25s cubic-bezier(.3, 1.6, .5, 1), opacity .2s; }
  .ft-link:hover, .ft-link:focus-visible { color: var(--color-cream); }
  .ft-link:hover .ft-led, .ft-link:focus-visible .ft-led {
    background: var(--color-coral); border-color: var(--color-coral);
    box-shadow: 0 0 0 3px rgba(240, 87, 77, .22), 0 0 14px 2px rgba(240, 87, 77, .8);
  }
  .ft-link:hover .ft-wire, .ft-link:focus-visible .ft-wire {
    width: 26px;
    background: repeating-linear-gradient(90deg, var(--color-coral) 0 6px, transparent 6px 10px) 0 0 / 20px 2px;
    animation: current .45s linear infinite;
  }
  .ft-link:hover .ft-out { transform: translate(2px, -2px); opacity: 1; }
  @keyframes current { to { background-position: 20px 0; } }

  /* simulator card: tilted, straightens on hover */
  .ft-sim {
    display: flex; flex-direction: column; width: 220px; padding: 18px 18px 16px;
    background: var(--color-cream); color: var(--color-ink); border-radius: 18px; text-decoration: none;
    box-shadow: 6px 6px 0 var(--color-red); transform: rotate(-5deg);
    transition: transform .35s cubic-bezier(.3, 1.6, .5, 1), box-shadow .25s;
  }
  .ft-sim-top { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 22px; line-height: 1; }
  .ft-sim-body { margin-top: 10px; font-size: 13px; line-height: 1.5; }
  .ft-sim-go { margin-top: 12px; padding-top: 10px; border-top: 2px dashed rgba(17, 17, 17, .2); font-weight: 600; font-size: 13px; color: var(--color-red); }
  .ft-sim:hover { transform: rotate(0) translateY(-4px) scale(1.04); box-shadow: 9px 9px 0 var(--color-coral); }

  /* ---------- wordmark: the brand logo, stem in Bagel Fat One, GRID in Archivo Expanded ---------- */
  .ft-word {
    display: flex; justify-content: space-between; align-items: baseline;
    margin: 0; padding: .04em 0 .06em; user-select: none;
    font-size: clamp(56px, 15.5vw, 210px); line-height: .9;
  }
  .ft-word span {
    display: block; cursor: default; color: transparent;
    -webkit-text-stroke: 2px rgba(255, 243, 224, .28); paint-order: stroke fill;
    transition: color .25s, -webkit-text-stroke .25s, text-shadow .3s, transform .35s cubic-bezier(.3, 1.6, .5, 1);
  }
  .w-stem { font-family: var(--font-display); }
  .w-grid { font-family: var(--font-label); font-weight: 900; font-stretch: 125%; font-size: .78em; }
  .ft-word span:hover + span,
  .ft-word span:has(+ span:hover) {
    color: rgba(227, 18, 27, .55);
    -webkit-text-stroke: 2px rgba(240, 87, 77, .85);
    text-shadow: 0 0 28px rgba(240, 87, 77, .35);
    transform: translateY(-3%);
  }
  .ft-word span:hover {
    color: var(--color-cream);
    -webkit-text-stroke: 7px var(--color-red);
    text-shadow: 7px 7px 0 var(--color-red-dark), 0 0 44px rgba(240, 87, 77, .65);
    transform: translateY(-7%) rotate(-3deg);
    transition-duration: .12s, .12s, .15s, .3s;
  }
  .ft-word[data-on] span { animation: power 1.1s cubic-bezier(.2, .8, .2, 1) calc(var(--i) * 90ms) backwards; }
  @keyframes power {
    0%, 100% { color: transparent; -webkit-text-stroke: 2px rgba(255, 243, 224, .28); text-shadow: none; }
    30%, 55% { color: var(--color-cream); -webkit-text-stroke: 7px var(--color-red); text-shadow: 7px 7px 0 var(--color-red-dark), 0 0 44px rgba(240, 87, 77, .65); }
  }

  /* ---------- bottom bar ---------- */
  .ft-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 22px; padding-top: 20px; border-top: 2px solid #2a2622; font-size: 13px; }
  .ft-bar p { margin: 0; }
  .ft-top { display: inline-flex; align-items: center; gap: 12px; color: var(--color-cream); text-decoration: none; font-weight: 500; font-size: 14px; }
  .ft-top-btn { display: grid; place-items: center; width: 42px; height: 42px; overflow: hidden; border: 2px solid var(--color-cream); border-radius: 50%; transition: background .2s, border-color .2s, color .2s, transform .2s; }
  .ft-top-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .ft-top:hover .ft-top-btn { background: var(--color-red); border-color: var(--color-red); color: #fff; transform: translateY(-3px); }
  .ft-top:hover .ft-top-btn svg { animation: launch .55s cubic-bezier(.5, 0, .3, 1); }
  @keyframes launch { 45% { transform: translateY(-160%); } 46% { transform: translateY(160%); } }

  @media (max-width: 960px) {
    .ft-call { grid-template-columns: 1fr; }
    .ft-cols { grid-template-columns: 1fr 1fr; }
    .ft-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .ft-cols { grid-template-columns: 1fr; }
    .ft-word span { -webkit-text-stroke-width: 1.5px; }
    .ft-bar { flex-direction: column-reverse; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ft-word[data-on] span, .ft-link:hover .ft-wire, .ft-top:hover .ft-top-btn svg, .ft-cta:hover svg { animation: none; }
    .ft-word span, .ft-sim, .ft-cta, .ft-logo { transition: none; }
  }
</style>
