---
// STEM doodle set from the brochure: robot, bolt, atom, code, gear, bulb, rocket, chip.
export type DoodleName = "robot" | "bolt" | "atom" | "code" | "gear" | "bulb" | "rocket" | "chip";
interface Props { name: DoodleName; class?: string }
const { name, class: cls } = Astro.props;
---
<svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "robot" && (
    <>
      <rect x="5" y="8" width="14" height="11" rx="3.5" />
      <path d="M12 8V5.2" /><circle cx="12" cy="4" r="1.2" />
      <circle cx="9.4" cy="12.8" r="1.3" /><circle cx="14.6" cy="12.8" r="1.3" />
      <path d="M10 16.2c1.3.9 2.7.9 4 0" /><path d="M3 12.5h2M19 12.5h2" />
    </>
  )}
  {name === "bolt" && <path d="M13.5 2.5 5 13.5h6.5l-1 8 8.5-11h-6.5z" />}
  {name === "atom" && (
    <>
      <circle cx="12" cy="12" r="1.6" />
      <ellipse cx="12" cy="12" rx="10" ry="4" />
      <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)" />
      <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-60 12 12)" />
    </>
  )}
  {name === "code" && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4.5l-4 15" />}
  {name === "gear" && (
    <>
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" />
      <circle cx="12" cy="12" r="6.5" />
    </>
  )}
  {name === "bulb" && (
    <>
      <path d="M9 17.5h6M10 21h4" />
      <path d="M12 3a6 6 0 0 0-3.8 10.6c.6.6.8 1.3.8 2.1v.3h6v-.3c0-.8.2-1.5.8-2.1A6 6 0 0 0 12 3z" />
      <path d="M12 16v-4l-1.5-1.5M12 12l1.5-1.5" />
    </>
  )}
  {name === "rocket" && (
    <>
      <path d="M12 2.5c3.2 2.8 4.4 7 3.2 11.3L12 17l-3.2-3.2C7.6 9.5 8.8 5.3 12 2.5z" />
      <circle cx="12" cy="9" r="1.6" />
      <path d="M8.8 13.8 6 16.6l.8 2.6 2.8-1.8M15.2 13.8l2.8 2.8-.8 2.6-2.8-1.8M12 19v2.5" />
    </>
  )}
  {name === "chip" && (
    <>
      <rect x="6" y="6" width="12" height="12" rx="2" />
      <rect x="9.5" y="9.5" width="5" height="5" rx=".8" />
      <path d="M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3" />
    </>
  )}
</svg>
