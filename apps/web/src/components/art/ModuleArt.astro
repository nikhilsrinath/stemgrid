---
// Inner artwork for each Quark module (everything except the housing).
// Shared by the assembled QuarkBoard and the standalone Sticker.
import Jst from "./Jst.astro";

export type ModuleKind =
  | "ultrasonic" | "ldr" | "ir" | "buzzer" | "servo" | "dht11"
  | "c3" | "rfid" | "oled" | "buttons" | "pot";

interface Props { kind: ModuleKind }
const { kind } = Astro.props;
---
{kind === "ultrasonic" && (
  <>
    <g class="us-waves" fill="none" stroke="#FFF3E0" stroke-width="5" stroke-linecap="round" opacity="0">
      <path class="wave w1" d="M70 -8 a40 40 0 0 1 60 0" />
      <path class="wave w2" d="M55 -26 a60 60 0 0 1 90 0" />
      <path class="wave w3" d="M40 -44 a80 80 0 0 1 120 0" />
    </g>
    <rect x="12" y="12" width="176" height="74" rx="8" fill="#2F6FD6" stroke="#111" stroke-width="3" />
    <circle cx="58" cy="49" r="31" fill="#D5DAE1" stroke="#111" stroke-width="3" />
    <circle cx="58" cy="49" r="21" fill="#3B4048" />
    <circle cx="142" cy="49" r="31" fill="#D5DAE1" stroke="#111" stroke-width="3" />
    <circle cx="142" cy="49" r="21" fill="#3B4048" />
    <path d="M44 40a18 18 0 0 1 14-8M128 40a18 18 0 0 1 14-8" stroke="#8C949F" stroke-width="3" fill="none" stroke-linecap="round" />
    <rect x="90" y="40" width="20" height="18" rx="4" fill="#C7CCD3" stroke="#111" stroke-width="2.5" />
    <Jst x={100} y={104} />
  </>
)}

{kind === "ldr" && (
  <>
    <rect x="10" y="10" width="70" height="58" rx="6" fill="#1F8A4C" stroke="#111" stroke-width="3" />
    <circle cx="45" cy="38" r="15" fill="#F2DFB8" stroke="#111" stroke-width="3" />
    <path d="M36 32h18M36 37h18M36 42h18" stroke="#B24A2B" stroke-width="2.5" />
    <circle class="led led-ldr" cx="22" cy="20" r="4.5" fill="#5B1010" />
    <Jst x={45} y={84} />
  </>
)}

{kind === "ir" && (
  <>
    <rect x="10" y="10" width="70" height="58" rx="6" fill="#1F8A4C" stroke="#111" stroke-width="3" />
    <rect x="31" y="20" width="28" height="34" rx="9" fill="#1A1A1A" stroke="#111" stroke-width="2" />
    <circle cx="45" cy="34" r="7" fill="#3A3A3A" />
    <circle class="led led-ir" cx="68" cy="20" r="4.5" fill="#5B1010" />
    <Jst x={45} y={84} />
  </>
)}

{kind === "buzzer" && (
  <>
    <g class="sound" fill="none" stroke="#FFF3E0" stroke-width="5" stroke-linecap="round" opacity="0">
      <path class="wave w1" d="M108 30a26 26 0 0 1 0 30" />
      <path class="wave w2" d="M122 18a44 44 0 0 1 0 54" />
    </g>
    <rect x="10" y="10" width="80" height="58" rx="6" fill="#1F8A4C" stroke="#111" stroke-width="3" />
    <circle cx="50" cy="39" r="26" fill="#1A1A1A" stroke="#111" stroke-width="3" />
    <circle cx="50" cy="39" r="6" fill="#444" />
    <Jst x={50} y={84} />
  </>
)}

{kind === "servo" && (
  <>
    <rect x="22" y="40" width="76" height="84" rx="8" fill="#262626" stroke="#111" stroke-width="3" />
    <rect x="10" y="62" width="100" height="14" rx="4" fill="#262626" stroke="#111" stroke-width="3" />
    <g class="servo-arm">
      <rect x="51" y="-48" width="18" height="108" rx="9" fill="#FF6B1A" stroke="#111" stroke-width="3.5" />
      <circle cx="60" cy="-34" r="3.5" fill="#111" />
      <circle cx="60" cy="-14" r="3.5" fill="#111" />
    </g>
    <circle cx="60" cy="50" r="12" fill="#EDEAE3" stroke="#111" stroke-width="3" />
    <Jst x={60} y={134} />
  </>
)}

{kind === "dht11" && (
  <>
    <rect x="12" y="12" width="74" height="116" rx="6" fill="#1F8A4C" stroke="#111" stroke-width="3" />
    <rect x="20" y="20" width="58" height="76" rx="6" fill="#3B82D6" stroke="#111" stroke-width="3" />
    {[0, 1, 2, 3, 4].map((r) => (
      <g>
        <rect x="28" y={30 + r * 13} width="16" height="6" rx="2" fill="#1E4E91" />
        <rect x="54" y={30 + r * 13} width="16" height="6" rx="2" fill="#1E4E91" />
      </g>
    ))}
    <Jst x={102} y={70} rot={90} />
  </>
)}

{kind === "c3" && (
  <>
    <path d="M24 22l20 20M44 22l-20 20" stroke="#FF6B1A" stroke-width="8" stroke-linecap="round" />
    <circle cx="34" cy="70" r="11" fill="#FF6B1A" stroke="#111" stroke-width="3" />
    <rect x="112" y="70" width="104" height="54" rx="6" fill="#1A1A1A" stroke="#111" stroke-width="3" />
    {[0, 1, 2, 3, 4, 5, 6, 7].map((c) => (
      <g>
        <rect x={120 + c * 12} y="80" width="6" height="6" fill="#D9B24A" />
        <rect x={120 + c * 12} y="106" width="6" height="6" fill="#D9B24A" />
      </g>
    ))}
    <rect x="176" y="22" width="44" height="32" rx="4" fill="#2BA84A" stroke="#111" stroke-width="3" />
    <circle cx="189" cy="38" r="5" fill="#C9D6CE" stroke="#111" stroke-width="2" />
    <circle cx="207" cy="38" r="5" fill="#C9D6CE" stroke="#111" stroke-width="2" />
    <rect x="18" y="112" width="58" height="34" rx="10" fill="#1A1A1A" />
    <circle class="c3-led" cx="96" cy="44" r="8" fill="#5B1010" stroke="#111" stroke-width="2.5" />
    <text x="226" y="153" text-anchor="end" font-family="Archivo Variable, sans-serif" font-weight="900" font-size="13" letter-spacing="2" fill="#111" style="font-stretch:125%">QUARK C3</text>
    <Jst x={40} y={0} /><Jst x={90} y={0} /><Jst x={150} y={0} /><Jst x={200} y={0} />
    <Jst x={0} y={40} rot={90} /><Jst x={0} y={120} rot={90} />
    <Jst x={240} y={40} rot={90} /><Jst x={240} y={120} rot={90} />
    <Jst x={70} y={170} /><Jst x={180} y={170} />
  </>
)}

{kind === "rfid" && (
  <>
    <rect x="14" y="14" width="162" height="192" rx="8" fill="#2B5FC4" stroke="#111" stroke-width="3" />
    <g class="rfid-coil" fill="none" stroke="#9CC0FF" stroke-width="4">
      <rect x="30" y="28" width="130" height="104" rx="14" />
      <rect x="42" y="40" width="106" height="80" rx="10" />
      <rect x="54" y="52" width="82" height="56" rx="7" />
    </g>
    <rect x="76" y="148" width="38" height="38" rx="4" fill="#1A1A1A" stroke="#111" stroke-width="2" />
    <text x="95" y="86" text-anchor="middle" font-family="Archivo Variable, sans-serif" font-weight="900" font-size="13" letter-spacing="2" fill="#E8F0FF" style="font-stretch:125%">RFID</text>
    <Jst x={0} y={110} rot={90} />
  </>
)}

{kind === "oled" && (
  <>
    <rect x="14" y="16" width="122" height="104" rx="6" fill="#132235" stroke="#111" stroke-width="3" />
    <rect class="oled-screen" x="22" y="30" width="106" height="72" rx="3" fill="#050B12" />
    <g font-family="ui-monospace, monospace" font-weight="700" fill="#7DD3FC">
      <text class="oled-line" x="30" y="50" font-size="13" opacity="0">HELLO GRID!</text>
      <text class="oled-line" x="30" y="70" font-size="11" opacity="0">dist: 23 cm</text>
      <text class="oled-line" x="30" y="90" font-size="11" opacity="0">temp: 27°C</text>
    </g>
    {[0, 1, 2, 3].map((i) => <rect x={51 + i * 13} y="122" width="6" height="14" fill="#D9B24A" stroke="#111" stroke-width="1.5" />)}
    <Jst x={150} y={75} rot={90} />
  </>
)}

{kind === "buttons" && (
  <>
    <rect x="12" y="20" width="156" height="76" rx="6" fill="#1F8A4C" stroke="#111" stroke-width="3" />
    <circle cx="58" cy="58" r="27" fill="#2A2A2A" stroke="#111" stroke-width="3" />
    <circle class="btn-red" cx="58" cy="56" r="20" fill="#E3121B" stroke="#111" stroke-width="3" />
    <circle cx="122" cy="58" r="27" fill="#2A2A2A" stroke="#111" stroke-width="3" />
    <circle class="btn-white" cx="122" cy="56" r="20" fill="#F7F3EC" stroke="#111" stroke-width="3" />
    <Jst x={120} y={0} />
  </>
)}

{kind === "pot" && (
  <>
    <rect x="12" y="20" width="106" height="108" rx="6" fill="#1F8A4C" stroke="#111" stroke-width="3" />
    <g class="pot-knob">
      <circle cx="65" cy="76" r="40" fill="#1A1A1A" stroke="#111" stroke-width="3" />
      <circle cx="65" cy="76" r="30" fill="#262626" />
      <rect x="61" y="40" width="8" height="30" rx="4" fill="#FFC93C" />
    </g>
    <Jst x={65} y={0} />
  </>
)}
