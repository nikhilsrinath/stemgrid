---
// Map pin with a little school/house inside: "your place".
interface Props { class?: string }
const { class: cls } = Astro.props;
const pin = "M60 146 C60 146 10 94 10 58 A50 50 0 1 1 110 58 C110 94 60 146 60 146 Z";
---
<svg viewBox="0 0 120 150" class={cls} aria-hidden="true" overflow="visible">
  <path d={pin} fill="#FFF3E0" stroke="#111" stroke-width="4" transform="translate(7 8)" />
  <path d={pin} fill="#111" stroke="#111" stroke-width="5" stroke-linejoin="round" />
  <circle cx="60" cy="58" r="32" fill="#FFF3E0" stroke="#111" stroke-width="4" />
  <path d="M40 62 L60 42 L80 62 V80 H40 Z" fill="#E3121B" stroke="#111" stroke-width="4" stroke-linejoin="round" />
  <rect x="54" y="66" width="12" height="14" fill="#111" />
  <path d="M60 42 V30 L70 34 L60 38" fill="#E3121B" stroke="#111" stroke-width="3" stroke-linejoin="round" />
</svg>
