# The stemgrid Supabase project (shared with the simulator: owner decision, 25 Nov 2026)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: status changes, user creation, billing writes
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only if the enquiries ever live in a different project (default: the connection above)
ENQUIRIES_SUPABASE_URL=
ENQUIRIES_SUPABASE_SERVICE_ROLE_KEY=
# 'supabase' (default) or 'fixtures' (local testing only)
ENQUIRIES_SOURCE=supabase

NEXT_PUBLIC_PORTAL_URL=https://learn.stemgrid.in
NEXT_PUBLIC_CONSOLE_URL=https://admin.stemgrid.in
NEXT_PUBLIC_SIMULATOR_URL=https://simulator.stemgrid.in

# Online payments are OFF until the three RAZORPAY_* keys are set. 'mock' is for local testing only
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RESEND_API_KEY=
MAIL_FROM=StemGrid <info@stemgrid.in>
STAFF_NOTIFY_TO=

CRON_SECRET=

# Invoicing entity (still to be confirmed)
INVOICE_SELLER_NAME=StemGrid (placeholder)
INVOICE_SELLER_GSTIN=33XXXXXXXXXXXZX
INVOICE_SELLER_ADDRESS=Address to be confirmed
INVOICE_SELLER_STATE=Tamil Nadu
INVOICE_SAC_CODE=998431

TERMS_VERSION=2026-11-v1

# Local testing only. Never set in production (the build fails if it is).
# PORTAL_MODE=local
